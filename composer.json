{
    "name": "nitrado/nitrapi-php-lib",
    "description": "PHP SDK for Nitrapi",
    "keywords": ["nitrapi", "nitrado", "marbis", "api"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nitrapi\\": "lib/Nitrapi/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nitrapi\\Tests\\": "test/unit/"
        }
    },
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "php-http/discovery": "^1.14",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "nyholm/psr7": "^1.0",
        "php-http/mock-client": "^1.6",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
